# tomasulo-rv (nested repo: the top-level Tomasulo/.gitignore does not apply here)
# Build outputs: always regenerated by simulation/run_unit_tests.sh
simulation/build/*
!simulation/build/.gitkeep
*.vvp
xsim.dir/
.Xil/
*.jou
*.pb
*.wdb
__pycache__/
*.pyc
# Generated C-flow artifacts (rebuilt by mem_generator/Makefile)
*.elf
*.o
# Kept on purpose (evidence): *.log in evidence/, *.rpt (timing/utilization),
# *.vcd waveforms used as evidence, *.hex images used by a logged run.
ooo_fpga/build/
ooo_fpga/build_pipe_m/
ooo_fpga/build_pipe/
